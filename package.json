    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cypress": "^15.19.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^6.4.3",
